# ---- flower-backend environment ----
# Copy to .env and fill in real values. Do NOT commit the real .env.

# Postgres connection string the API connects to.
DATABASE_URL=postgresql://user:password@localhost:5432/flower

# Port the API listens on.
PORT=3001

# REQUIRED. Strong random secret used to sign/verify JWTs. Must be >= 32 chars.
# The app refuses to start if this is missing or too short.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Comma-separated extra CORS origins (in addition to the built-in production hosts).
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Admin user created by `prisma db seed`.
# SEED_ADMIN_PASSWORD is REQUIRED when NODE_ENV=production — seeding aborts
# rather than create a known default admin.
SEED_ADMIN_EMAIL=admin@freshpetalsindia.com
SEED_ADMIN_PASSWORD=

# Set to "production" in deployed environments.
NODE_ENV=development

# TEST ONLY (Playwright e2e). Exposes GET /auth/_test/last-reset-token when
# NODE_ENV=test AND this is 1. The app REFUSES to boot if NODE_ENV=production
# and this variable is set at all. Never set it in deployed environments.
# ENABLE_TEST_ENDPOINTS=1

# Optional error reporting. Leave unset to disable Sentry entirely (no network, no behaviour change).
SENTRY_DSN_API=
# SENTRY_RELEASE=   # e.g. git sha
