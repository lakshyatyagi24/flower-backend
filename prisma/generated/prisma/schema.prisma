generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id              Int         @id @default(autoincrement())
  name            String
  slug            String      @unique
  image           String?
  description     String?
  parentId        Int?
  parent          Category?   @relation("CategoryChildren", fields: [parentId], references: [id])
  children        Category[]  @relation("CategoryChildren")
  products        Product[]
  productType     ProductType @default(CUT_FLOWER)
  defaultSaleMode SaleMode    @default(PURCHASE)
  defaultGstRate  Float       @default(0)
  sortOrder       Int         @default(0)
  active          Boolean     @default(true)
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  slug        String      @unique
  description String?
  price       Float       @default(0)
  image       String?
  stock       Int         @default(0)
  featured    Boolean     @default(false)
  active      Boolean     @default(true)
  productType ProductType @default(CUT_FLOWER)
  saleMode    SaleMode    @default(PURCHASE)
  gstRate     Float       @default(0)
  unit        String      @default("piece")
  minOrderQty Int         @default(1)
  category    Category?   @relation(fields: [categoryId], references: [id])
  categoryId  Int?
  orderItems  OrderItem[]
  bookings    Booking[]
  enquiries   Enquiry[]
  reviews     Review[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

enum ProductType {
  CUT_FLOWER
  PLANT
  BOUQUET
  ARRANGEMENT
  HAMPER
}

enum SaleMode {
  PURCHASE
  ENQUIRY
}

model User {
  id        Int       @id @default(autoincrement())
  name      String?
  email     String    @unique
  password  String
  phone     String?
  role      UserRole  @default(CUSTOMER)
  orders    Order[]
  bookings  Booking[]
  enquiries Enquiry[]
  reviews   Review[]
  createdAt DateTime  @default(now())
}

enum UserRole {
  CUSTOMER
  ADMIN
}

model Order {
  id              Int         @id @default(autoincrement())
  user            User?       @relation(fields: [userId], references: [id])
  userId          Int?
  items           OrderItem[]
  subtotal        Float       @default(0)
  shipping        Float       @default(0)
  gst             Float       @default(0)
  total           Float
  status          OrderStatus @default(PENDING)
  paymentMethod   String      @default("COD")
  customerName    String?
  customerEmail   String?
  customerPhone   String?
  shippingAddress String?
  city            String?
  postalCode      String?
  notes           String?
  // Fulfillment tracking — visible to admins, surfaced to customers via the tracking page.
  trackingNumber  String?
  courierName     String?
  // Internal-only — admin scratchpad, never returned to customers.
  adminNotes      String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  order       Order    @relation(fields: [orderId], references: [id])
  orderId     Int
  product     Product? @relation(fields: [productId], references: [id])
  productId   Int?
  productName String
  quantity    Int      @default(1)
  unitPrice   Float
  gstRate     Float    @default(0)
  gstAmount   Float    @default(0)
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Booking {
  id          Int           @id @default(autoincrement())
  user        User?         @relation(fields: [userId], references: [id])
  userId      Int?
  product     Product?      @relation(fields: [productId], references: [id])
  productId   Int?
  bookingDate DateTime
  quantity    Int           @default(1)
  status      BookingStatus @default(PENDING)
  notes       String?
  createdAt   DateTime      @default(now())
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
}

model Slider {
  id        Int     @id @default(autoincrement())
  title     String?
  eyebrow   String?
  subtitle  String?
  alt       String?
  image     String?
  href      String?
  // Arbitrary JSON configuration for overlay, colors, placement and button
  config    Json?
  sortOrder Int     @default(0)
  active    Boolean @default(true)
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Review {
  id        Int      @id @default(autoincrement())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  rating    Int
  title     String?
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId])
  @@index([productId])
}

model Enquiry {
  id            Int           @id @default(autoincrement())
  user          User?         @relation(fields: [userId], references: [id])
  userId        Int?
  product       Product?      @relation(fields: [productId], references: [id])
  productId     Int?
  productName   String?
  customerName  String
  customerEmail String?
  customerPhone String
  quantity      Int?
  eventDate     DateTime?
  occasion      String?
  budget        Float?
  address       String?
  city          String?
  message       String?
  source        String        @default("website")
  status        EnquiryStatus @default(NEW)
  adminNotes    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, createdAt])
}

enum EnquiryStatus {
  NEW
  CONTACTED
  QUOTED
  CONVERTED
  CLOSED
}
